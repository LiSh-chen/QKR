<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:background="@drawable/widget_background"
    android:columnCount="2"
    android:rowCount="2">

    <Button
        android:id="@+id/btn_q1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="3dp"
        android:text="必要\n日常"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:shadowColor="#40000000"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:background="@drawable/widget_btn_q1" />

    <Button
        android:id="@+id/btn_q2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="3dp"
        android:text="必要\n臨時"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:shadowColor="#40000000"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:background="@drawable/widget_btn_q2" />

    <Button
        android:id="@+id/btn_q3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="3dp"
        android:text="非必要\n日常"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:shadowColor="#40000000"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:background="@drawable/widget_btn_q3" />

    <Button
        android:id="@+id/btn_q4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="3dp"
        android:text="非必要\n臨時"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:shadowColor="#40000000"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:background="@drawable/widget_btn_q4" />
</GridLayout>
