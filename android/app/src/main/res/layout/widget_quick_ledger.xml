<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:background="@drawable/widget_background"
    android:columnCount="2"
    android:rowCount="3">

    <Button
        android:id="@+id/btn_voice"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnSpan="2"
        android:layout_columnWeight="1"
        android:layout_rowWeight="0.85"
        android:layout_margin="3dp"
        android:text="🎤 語音記帳"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#7a3d14"
        android:background="@drawable/widget_btn_voice" />

    <Button
        android:id="@+id/btn_q1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="3dp"
        android:text="必要\n固定"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#2e5c26"
        android:background="@drawable/widget_btn_q1" />

    <Button
        android:id="@+id/btn_q2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="3dp"
        android:text="必要\n偶發"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#1e4a78"
        android:background="@drawable/widget_btn_q2" />

    <Button
        android:id="@+id/btn_q3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="3dp"
        android:text="非必要\n固定"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#7a5314"
        android:background="@drawable/widget_btn_q3" />

    <Button
        android:id="@+id/btn_q4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_columnWeight="1"
        android:layout_rowWeight="1"
        android:layout_margin="3dp"
        android:text="非必要\n偶發"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#7a2020"
        android:background="@drawable/widget_btn_q4" />
</GridLayout>
